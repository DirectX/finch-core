# This file is for reference only.
# The server uses environment variables from the root .env file.
# Copy the root .env.example to .env and update the values.

# Database
DATABASE_URL=postgresql://finch:changeme@localhost:5432/finch_collab

# Authentication
JWT_SECRET=change_this_to_a_long_random_string

# Server
PORT=4000

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=finch-collab
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme
S3_REGION=us-east-1

# Other Services
RUST_API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
